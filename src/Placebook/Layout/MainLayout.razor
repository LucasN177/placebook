@inherits LayoutComponentBase
@implements IDisposable
@inject CategoryState CategoryState
@inject SyncService Sync
@inject AuthService Auth
@inject AccountDialogs AccountDialogs
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudThemeProvider @ref="_themeProvider" Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="() => _drawerOpen = !_drawerOpen" aria-label="Menü" />
        <MudIcon Icon="@Icons.Material.Filled.Place" Class="mx-2 d-none d-sm-flex" />
        <MudText Typo="Typo.h6" Class="d-none d-sm-flex">Placebook</MudText>

        @if (CategoryState.Current is { } current)
        {
            <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Class="ml-sm-4">
                <ActivatorContent>
                    <MudButton Color="Color.Inherit" Variant="Variant.Text" StartIcon="@CategoryIcons.For(current)"
                               EndIcon="@(CategoryState.Categories.Count > 1 ? Icons.Material.Filled.ArrowDropDown : null)"
                               Style="text-transform:none" aria-label="Kategorie wählen"
                               OnClick="@(e => context.ToggleAsync(e))">
                        @current.Name
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    @foreach (var category in CategoryState.Categories)
                    {
                        <MudMenuItem Icon="@CategoryIcons.For(category)" OnClick="() => CategoryState.SelectAsync(category)">
                            @category.Name <span class="mud-text-secondary ml-2">@category.Count.ToString("N0")</span>
                        </MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        }

        <MudSpacer />
        @if (Sync.Status is not (SyncStatus.NotConfigured or SyncStatus.Disabled))
        {
            <MudTooltip Text="@SyncTooltip">
                <MudIconButton Icon="@SyncIcon" Color="Color.Inherit" Href="settings" aria-label="@SyncTooltip" />
            </MudTooltip>
        }
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="() => _isDarkMode = !_isDarkMode"
                       aria-label="Farbschema wechseln" />
        @if (Auth.IsConfigured)
        {
            @if (Auth.User is { } user)
            {
                <MudTooltip Text="@($"Angemeldet als {user.Email}")">
                    <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" Href="account"
                                   aria-label="Konto" />
                </MudTooltip>
            }
            else
            {
                <MudTooltip Text="Anmelden">
                    <MudIconButton Icon="@Icons.Material.Outlined.AccountCircle" Color="Color.Inherit"
                                   OnClick="AccountDialogs.SignInAsync" aria-label="Anmelden" />
                </MudTooltip>
            }
        }
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Temporary" Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pb-0">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private const string DefaultColor = "#DA291C";

    private MudTheme _theme = CreateTheme(DefaultColor);
    private MudThemeProvider _themeProvider = default!;
    private bool _drawerOpen;
    private bool _isDarkMode;

    private string SyncIcon => Sync.Status switch
    {
        SyncStatus.Syncing => Icons.Material.Filled.CloudSync,
        SyncStatus.Error => Icons.Material.Filled.CloudOff,
        _ when Sync.PendingCount > 0 => Icons.Material.Filled.CloudUpload,
        _ => Icons.Material.Filled.CloudDone
    };

    private string SyncTooltip => Sync.Status switch
    {
        SyncStatus.Syncing => "Synchronisiere …",
        SyncStatus.Error => "Nicht synchronisiert – " + Sync.LastError,
        _ when Sync.PendingCount > 0 => "Änderungen warten auf Upload",
        _ => "In der Cloud gespeichert"
    };

    protected override async Task OnInitializedAsync()
    {
        CategoryState.Changed += OnCategoryChanged;
        Sync.StatusChanged += OnSyncStatusChanged;
        Auth.Changed += OnSyncStatusChanged;
        await CategoryState.EnsureLoadedAsync();
        _ = Sync.StartAsync(); // läuft im Hintergrund; Fehler landen im Sync-Status
    }

    private void OnSyncStatusChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDarkMode = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
            await HandleAuthRedirectAsync();
        }
    }

    /// <summary>Rückkehr aus einer Supabase-Mail (Registrierung bestätigt, Passwort vergessen).</summary>
    private async Task HandleAuthRedirectAsync()
    {
        if (!Auth.IsConfigured) return;
        try
        {
            switch (await Auth.HandleRedirectAsync(Navigation.Uri))
            {
                case { Kind: AuthRedirectKind.Recovery }:
                    await AccountDialogs.ChangePasswordAsync(isRecovery: true);
                    break;
                case { Kind: AuthRedirectKind.SignedIn }:
                    Snackbar.Add("E-Mail bestätigt – du bist angemeldet.", Severity.Success);
                    break;
                case { Kind: AuthRedirectKind.Error } error:
                    Snackbar.Add(error.ErrorCode == "otp_expired"
                        ? "Der Link ist abgelaufen oder wurde schon verwendet. Fordere bitte einen neuen an."
                        : $"Der Link hat nicht funktioniert: {error.ErrorDescription}", Severity.Error);
                    break;
            }
        }
        catch (AuthException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Die App übernimmt die Farbe der gewählten Kategorie.</summary>
    private void OnCategoryChanged()
    {
        _theme = CreateTheme(CategoryState.Current?.Color ?? DefaultColor);
        StateHasChanged();
    }

    private static MudTheme CreateTheme(string color) => new()
    {
        PaletteLight = new PaletteLight { Primary = color, AppbarBackground = color },
        PaletteDark = new PaletteDark { Primary = color }
    };

    public void Dispose()
    {
        CategoryState.Changed -= OnCategoryChanged;
        Sync.StatusChanged -= OnSyncStatusChanged;
        Auth.Changed -= OnSyncStatusChanged;
    }
}
