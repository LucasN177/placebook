@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_element" class="pb-map"></div>

@code {
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<LeafletMap>? _dotNetRef;
    private int _mapId;

    /// <summary>Wird ausgelöst, sobald die Karte initialisiert ist und Orte gesetzt werden können.</summary>
    [Parameter] public EventCallback OnReady { get; set; }

    /// <summary>Wird ausgelöst, wenn auf einen Marker geklickt wird (Parameter: Orts-ID).</summary>
    [Parameter] public EventCallback<string> OnPlaceClicked { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/map.js");
        _dotNetRef = DotNetObjectReference.Create(this);
        _mapId = await _module.InvokeAsync<int>("createMap", _element, _dotNetRef);
        await OnReady.InvokeAsync();
    }

    public async Task SetPlacesAsync(IEnumerable<Place> places, IEnumerable<string> visitedIds, string color)
    {
        if (_module is null) return;
        // Primitive Arrays statt Objektliste: deutlich schneller über die Interop-Grenze zu serialisieren
        var list = places as IReadOnlyList<Place> ?? places.ToList();
        var ids = new string[list.Count];
        var lats = new double[list.Count];
        var lons = new double[list.Count];
        for (var i = 0; i < list.Count; i++)
        {
            ids[i] = list[i].Id;
            lats[i] = list[i].Lat;
            lons[i] = list[i].Lon;
        }
        await _module.InvokeVoidAsync("setPlaces", _mapId, ids, lats, lons, visitedIds, color);
    }

    public async Task SetVisitedAsync(string placeId, bool isVisited)
    {
        if (_module is not null) await _module.InvokeVoidAsync("setVisited", _mapId, placeId, isVisited);
    }

    public async Task FlyToAsync(double lat, double lon, int? zoom = null)
    {
        if (_module is not null) await _module.InvokeVoidAsync("flyTo", _mapId, lat, lon, zoom);
    }

    public async Task ShowUserLocationAsync(GeoPosition position)
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("showUserLocation", _mapId, position.Lat, position.Lon, position.Accuracy);
    }

    public async Task ShowEuropeAsync()
    {
        if (_module is not null) await _module.InvokeVoidAsync("showEurope", _mapId);
    }

    [JSInvokable("OnPlaceClicked")]
    public Task HandlePlaceClicked(string placeId) => OnPlaceClicked.InvokeAsync(placeId);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _mapId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Seite wird gerade verlassen
            }
        }
        _dotNetRef?.Dispose();
    }
}
