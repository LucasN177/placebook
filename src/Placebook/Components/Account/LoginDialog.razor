@inject AuthService Auth

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Anmelden</MudText>
    </TitleContent>
    <DialogContent>
        <form @onsubmit="SignInAsync" @onsubmit:preventDefault="true" class="pb-auth-form">
            <MudStack Spacing="3">
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }
                @if (_info is not null)
                {
                    <MudAlert Severity="Severity.Success" Dense="true">@_info</MudAlert>
                }

                <MudTextField T="string" @bind-Value="_email" Label="E-Mail" InputType="InputType.Email" Immediate="true"
                              Variant="Variant.Outlined" AutoFocus="true" autocomplete="email" />
                <MudTextField T="string" @bind-Value="_password" Label="Passwort" Immediate="true" Variant="Variant.Outlined"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)" autocomplete="current-password"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="() => _showPassword = !_showPassword" AdornmentAriaLabel="Passwort anzeigen" />

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           Disabled="_busy">
                    @if (_busy)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                    }
                    Anmelden
                </MudButton>

                <MudStack Row="true" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="SendResetAsync" Disabled="_busy">
                        Passwort vergessen?
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                               OnClick="() => Dialog.Close(DialogResult.Ok(AccountDialogs.SwitchToRegister))">
                        Neues Konto erstellen
                    </MudButton>
                </MudStack>
            </MudStack>
        </form>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public string? Email { get; set; }

    private string? _email;
    private string? _password;
    private bool _showPassword;
    private bool _busy;
    private string? _error;
    private string? _info;

    protected override void OnInitialized() => _email = Email;

    private async Task SignInAsync()
    {
        _error = AuthText.ValidateEmail(_email) ?? (string.IsNullOrEmpty(_password) ? "Bitte gib dein Passwort ein." : null);
        _info = null;
        if (_error is not null) return;

        _busy = true;
        try
        {
            await Auth.SignInAsync(_email!, _password!);
            Dialog.Close(DialogResult.Ok(AccountDialogs.SignedIn));
        }
        catch (AuthException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SendResetAsync()
    {
        _error = AuthText.ValidateEmail(_email);
        _info = null;
        if (_error is not null)
        {
            _error = "Gib oben deine E-Mail-Adresse ein, dann schicken wir dir einen Link zum Zurücksetzen.";
            return;
        }

        _busy = true;
        try
        {
            await Auth.SendPasswordResetAsync(_email!);
            _info = "Falls es ein Konto mit dieser Adresse gibt, ist eine E-Mail mit einem Link zum Zurücksetzen unterwegs.";
        }
        catch (AuthException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
