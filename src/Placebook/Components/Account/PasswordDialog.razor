@inject AuthService Auth

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsRecovery ? "Neues Passwort festlegen" : "Passwort ändern")</MudText>
    </TitleContent>
    <DialogContent>
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true" class="pb-auth-form">
            <MudStack Spacing="3">
                @if (IsRecovery)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Du bist über den Link aus der E-Mail angemeldet. Lege jetzt ein neues Passwort fest.
                    </MudText>
                }
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }

                @* Für Passwort-Manager: zugehörige E-Mail als verstecktes Feld *@
                <input type="email" autocomplete="username" value="@Auth.User?.Email" hidden readonly />
                <MudTextField T="string" @bind-Value="_password" Label="Neues Passwort" Immediate="true" Variant="Variant.Outlined"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)" autocomplete="new-password"
                              AutoFocus="true" HelperText="@($"Mindestens {AuthText.MinPasswordLength} Zeichen")"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="() => _showPassword = !_showPassword" AdornmentAriaLabel="Passwort anzeigen" />
                <MudTextField T="string" @bind-Value="_confirmation" Label="Passwort wiederholen" Immediate="true"
                              Variant="Variant.Outlined" InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              autocomplete="new-password" />

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text" OnClick="() => Dialog.Cancel()" Disabled="_busy">Abbrechen</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">
                        Speichern
                    </MudButton>
                </MudStack>
            </MudStack>
        </form>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>Aufgerufen über den Link aus der „Passwort vergessen“-Mail.</summary>
    [Parameter] public bool IsRecovery { get; set; }

    private string? _password;
    private string? _confirmation;
    private bool _showPassword;
    private bool _busy;
    private string? _error;

    private async Task SaveAsync()
    {
        _error = AuthText.ValidateNewPassword(_password, _confirmation);
        if (_error is not null) return;

        _busy = true;
        try
        {
            await Auth.UpdatePasswordAsync(_password!);
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (AuthException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
