    <MudPaper Class="pa-6" Elevation="1">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Public" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h5">Hier entsteht die Europakarte</MudText>
            <MudText Align="Align.Center" Class="mud-text-secondary">
                Bald findest du hier alle McDonald's-Filialen in Europa und kannst markieren, wo du schon warst.
            </MudText>
        </MudStack>
    </MudPaper>
</MudContainer>
