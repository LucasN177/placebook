@page "/"
@implements IDisposable
@inject CategoryState CategoryState
@inject VisitService Visits
@inject BrowserService Browser
@inject IBrowserViewportService Viewport
@inject ISnackbar Snackbar

<PageTitle>Karte – Placebook</PageTitle>

<div class="pb-map-page">
    <LeafletMap @ref="_map" OnReady="OnMapReadyAsync" OnPlaceClicked="OnPlaceClicked" />

    <MudPaper Class="pb-map-overlay pa-3" Elevation="3">
        @if (Category is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Class="mt-2">Lade Orte …</MudText>
        }
        else
        {
            <MudStack Spacing="1">
                <MudText Typo="Typo.body2">
                    <b>@VisitedCount.ToString("N0")</b> von @Places.Count.ToString("N0") @Category.Name besucht
                    (@Percent.ToString(Percent is > 0 and < 1 ? "0.00" : "0.0") %)
                </MudText>
                <MudProgressLinear Value="Percent" Color="Color.Primary" Rounded="true" Size="Size.Small" />

                <MudChipSet T="VisitFilter" SelectedValue="_filter" SelectedValueChanged="SetFilterAsync"
                            SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Size="Size.Small">
                    <MudChip Value="VisitFilter.All" Text="Alle" SelectedColor="Color.Primary" />
                    <MudChip Value="VisitFilter.Visited" Text="Besucht" SelectedColor="Color.Primary" />
                    <MudChip Value="VisitFilter.Open" Text="Offen" SelectedColor="Color.Primary" />
                </MudChipSet>
            </MudStack>
        }
    </MudPaper>

    <div class="pb-map-fabs">
        <MudTooltip Text="Nächster offener Ort" Placement="Placement.Left">
            <MudFab Color="Color.Primary" Size="Size.Medium" StartIcon="@Icons.Material.Filled.NearMe"
                    OnClick="ShowNearestOpenAsync" Disabled="Category is null || _locating" aria-label="Nächster offener Ort" />
        </MudTooltip>
        <MudTooltip Text="Mein Standort" Placement="Placement.Left">
            <MudFab Color="Color.Default" Size="Size.Small" Class="pb-fab-surface" StartIcon="@Icons.Material.Filled.MyLocation"
                    OnClick="ShowMyLocationAsync" Disabled="_locating" aria-label="Mein Standort" />
        </MudTooltip>
        <MudTooltip Text="Ganz Europa anzeigen" Placement="Placement.Left">
            <MudFab Color="Color.Default" Size="Size.Small" Class="pb-fab-surface" StartIcon="@Icons.Material.Filled.Public"
                    OnClick="() => _map.ShowEuropeAsync()" aria-label="Ganz Europa anzeigen" />
        </MudTooltip>
    </div>
</div>

@* Auf schmalen Bildschirmen fährt der Drawer von unten ein, sonst von rechts *@
<MudDrawer @bind-Open="_detailsOpen" Anchor="@(_narrow ? Anchor.Bottom : Anchor.End)" Variant="DrawerVariant.Temporary"
           Width="@(_narrow ? null : "360px")" Height="@(_narrow ? "auto" : null)" Elevation="4" Class="pb-details">
    @if (_selected is not null && Category is not null)
    {
        <MudDrawerHeader Class="pb-0">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@_selected.DisplayName(Category)</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @(_selected.DisplayAddress ?? "Adresse unbekannt") · @Countries.Name(_selected.CountryCode)
                </MudText>
                @if (Browser.LastPosition is { } position)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @Geo.FormatDistance(Geo.DistanceKm(position.Lat, position.Lon, _selected.Lat, _selected.Lon)) entfernt
                    </MudText>
                }
            </MudStack>
        </MudDrawerHeader>
        <MudStack Class="pa-4" Spacing="3">
            <MudSwitch T="bool" Value="_selectedVisit is not null" ValueChanged="ToggleVisitedAsync" Color="Color.Primary">
                Besucht
            </MudSwitch>

            @if (_selectedVisit is not null)
            {
                <MudDatePicker Label="Besucht am" Date="ToDateTime(_selectedVisit.VisitedAt)" DateChanged="SetVisitDateAsync"
                               Clearable="true" MaxDate="DateTime.Today" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField T="string" Label="Notiz" Value="_selectedVisit.Note" ValueChanged="SetVisitNoteAsync"
                              Lines="3" Variant="Variant.Outlined" MaxLength="500" />
            }

            <MudStack Row="true" Spacing="1">
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ZoomIn"
                           OnClick="() => _map.FlyToAsync(_selected.Lat, _selected.Lon, 17)">Heranzoomen</MudButton>
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.OpenInNew" Target="_blank"
                           Href="@OsmUrl(_selected)">OpenStreetMap</MudButton>
            </MudStack>
        </MudStack>
    }
</MudDrawer>

@code {
    /// <summary>Optional: Orts-ID, die nach dem Laden angesprungen wird (z. B. aus der Listenansicht).</summary>
    [SupplyParameterFromQuery(Name = "place")]
    public string? PlaceId { get; set; }

    private LeafletMap _map = default!;
    private bool _mapReady;
    private VisitFilter _filter = VisitFilter.All;

    private bool _detailsOpen;
    private bool _narrow;
    private bool _locating;
    private Place? _selected;
    private Visit? _selectedVisit;

    private Category? Category => CategoryState.Current;
    private IReadOnlyList<Place> Places => CategoryState.Places;
    // Nur Besuche zählen, deren Ort es in den aktuellen Daten noch gibt
    private int VisitedCount => Category is null ? 0 : Visits.GetVisitedIds(Category.Id).Count(CategoryState.PlacesById.ContainsKey);
    private double Percent => Places.Count == 0 ? 0 : 100.0 * VisitedCount / Places.Count;

    protected override void OnInitialized()
    {
        Visits.Changed += StateHasChanged;
        CategoryState.Changed += OnCategoryChanged;
        Visits.ExternallyChanged += OnVisitsExternallyChanged;
    }

    private async Task OnMapReadyAsync()
    {
        try
        {
            await Visits.EnsureLoadedAsync();
            await CategoryState.EnsureLoadedAsync();
            _mapReady = true;
            await RenderMarkersAsync();

            if (PlaceId is not null && CategoryState.PlacesById.TryGetValue(PlaceId, out var place))
            {
                await _map.FlyToAsync(place.Lat, place.Lon, 16);
                await OnPlaceClicked(place.Id);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Orte konnten nicht geladen werden: {ex.Message}", Severity.Error);
        }
    }

    // Import oder Synchronisierung: viele Besuche auf einmal geändert – Marker komplett neu zeichnen
    private void OnVisitsExternallyChanged() => _ = InvokeAsync(async () =>
    {
        if (_selected is not null && Category is not null)
            _selectedVisit = Visits.GetVisit(Category.Id, _selected.Id);
        await RenderMarkersAsync();
        StateHasChanged();
    });

    private void OnCategoryChanged() => _ = InvokeAsync(async () =>
    {
        _detailsOpen = false;
        _selected = null;
        await RenderMarkersAsync();
        StateHasChanged();
    });

    private async Task SetFilterAsync(VisitFilter filter)
    {
        _filter = filter;
        await RenderMarkersAsync();
    }

    private async Task RenderMarkersAsync()
    {
        if (!_mapReady || Category is null) return;
        var visited = Visits.GetVisitedIds(Category.Id);
        var places = _filter switch
        {
            VisitFilter.Visited => Places.Where(p => visited.Contains(p.Id)),
            VisitFilter.Open => Places.Where(p => !visited.Contains(p.Id)),
            _ => Places
        };
        await _map.SetPlacesAsync(places, visited, Category.Color);
    }

    private async Task OnPlaceClicked(string placeId)
    {
        if (Category is null || !CategoryState.PlacesById.TryGetValue(placeId, out var place)) return;
        _narrow = await Viewport.IsMediaQueryMatchAsync("(max-width: 600px)");
        _selected = place;
        _selectedVisit = Visits.GetVisit(Category.Id, placeId);
        _detailsOpen = true;
    }

    private async Task<GeoPosition?> LocateAsync()
    {
        _locating = true;
        try
        {
            var position = await Browser.GetCurrentPositionAsync();
            await _map.ShowUserLocationAsync(position);
            return position;
        }
        catch (JSException ex)
        {
            // JSException enthält den JS-Stacktrace – für Nutzer reicht die erste Zeile
            Snackbar.Add(ex.Message.Split('\n')[0], Severity.Warning);
            return null;
        }
        finally
        {
            _locating = false;
        }
    }

    private async Task ShowMyLocationAsync()
    {
        if (await LocateAsync() is { } position)
            await _map.FlyToAsync(position.Lat, position.Lon, 13);
    }

    private async Task ShowNearestOpenAsync()
    {
        if (Category is null || await LocateAsync() is not { } position) return;

        var nearest = Places
            .Where(p => !Visits.IsVisited(Category.Id, p.Id))
            .MinBy(p => Geo.DistanceKm(position.Lat, position.Lon, p.Lat, p.Lon));
        if (nearest is null)
        {
            Snackbar.Add($"Du hast alle {Category.Name}-Orte besucht! 🎉", Severity.Success);
            return;
        }

        await _map.FlyToAsync(nearest.Lat, nearest.Lon, 16);
        await OnPlaceClicked(nearest.Id);
    }

    private async Task ToggleVisitedAsync(bool visited)
    {
        if (visited)
            await SaveVisitAsync(new Visit(DateOnly.FromDateTime(DateTime.Today), null));
        else
        {
            await Visits.RemoveVisitAsync(Category!.Id, _selected!.Id);
            _selectedVisit = null;
        }

        // Im gefilterten Modus muss der Marker ein- bzw. ausgeblendet werden, sonst reicht Umfärben
        if (_filter == VisitFilter.All)
            await _map.SetVisitedAsync(_selected!.Id, visited);
        else
            await RenderMarkersAsync();
    }

    private Task SetVisitDateAsync(DateTime? date) =>
        SaveVisitAsync(_selectedVisit! with { VisitedAt = date is null ? null : DateOnly.FromDateTime(date.Value) });

    private Task SetVisitNoteAsync(string? note) =>
        SaveVisitAsync(_selectedVisit! with { Note = string.IsNullOrWhiteSpace(note) ? null : note.Trim() });

    private async Task SaveVisitAsync(Visit visit)
    {
        _selectedVisit = visit;
        await Visits.SetVisitAsync(Category!.Id, _selected!.Id, visit);
    }

    private static DateTime? ToDateTime(DateOnly? date) => date?.ToDateTime(TimeOnly.MinValue);

    private static string OsmUrl(Place place)
    {
        var type = place.Id[0] switch { 'n' => "node", 'w' => "way", _ => "relation" };
        return $"https://www.openstreetmap.org/{type}/{place.Id[1..]}";
    }

    public void Dispose()
    {
        Visits.Changed -= StateHasChanged;
        CategoryState.Changed -= OnCategoryChanged;
        Visits.ExternallyChanged -= OnVisitsExternallyChanged;
    }
}
